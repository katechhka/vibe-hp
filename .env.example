# demo or yookassa_test. Live payments are forbidden.
PAYMENT_MODE=demo
APP_URL=http://127.0.0.1:3000
# Use a persistent, writable local volume. Do not put the database in public/.
DATABASE_PATH=./data/shop.sqlite

# Real email is disabled until credentials are configured. Server only.
EMAIL_MODE=disabled
RESEND_API_KEY=
# First test: onboarding@resend.dev (recipient must be account owner).
EMAIL_FROM=

# Server-only credentials of a TEST shop. Set PAYMENT_MODE=yookassa_test to enable.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Initial admin hash (scrypt salt:hash). Run npm run admin:setup locally.
ADMIN_PASSWORD_HASH=
UPLOADS_PATH=./data/uploads

# Optional destination for complete SQLite + photo backups.
BACKUP_PATH=./data/backups

# Supabase migration (server only; the current SQLite store is not switched automatically).
SUPABASE_URL=
DATABASE_URL=
SUPABASE_CA_CERT_PATH=./supabase-ca.crt
SUPABASE_SECRET_KEY=

# Explicit database/storage selection. Keep sqlite/local until migration is verified.
DB_DRIVER=sqlite
STORAGE_DRIVER=local
PG_SCHEMA=shop
SUPABASE_STORAGE_BUCKET=product-images
# Optional session pooler URL for migrations (never expose to client).
MIGRATION_DATABASE_URL=
